{
  "name": "fusio/adapter-http",
  "description": "Provides a connection to send and retrieve HTTP messages",
  "homepage": "https://www.fusio-project.org",
  "keywords": ["fusio-adapter"],
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Christoph Kappestein",
      "email": "christoph.kappestein@gmail.com",
      "homepage": "https://chrisk.app"
    }
  ],
  "require": {
    "php": "^8.2",
    "fusio/engine": "~6.6.1.0",
    "guzzlehttp/guzzle": "^7.0",
    "kevinrob/guzzle-cache-middleware": "^5.1",
    "twig/twig": "^3.0",
    "symfony/dotenv": "^7.1",
    "predis/predis": "^2.1",
    "doctrine/cache": "^1.13",
    "zhang1career/paganini": "^0.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "vimeo/psalm": "^5.9",
    "mikey179/vfsstream": "^1.6"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/zhang1career/fusio-engine.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/zhang1career/paganini.git"
    }
  ],
  "autoload": {
    "psr-4": {
      "Fusio\\Adapter\\Http\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Fusio\\Adapter\\Http\\Tests\\": "tests/"
    }
  }
}
